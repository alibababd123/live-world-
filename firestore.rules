rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomExists(roomId) { return exists(/databases/$(database)/documents/rooms/$(roomId)); }
    function isMember(roomId) { return exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)); }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.status == 'open';
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        allow read: if signedIn() && isMember(roomId);
        allow create: if signedIn() && request.auth.uid == uid
          && roomExists(roomId)
          && request.resource.data.uid == uid;
        allow delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }

      match /messages/{messageId} {
        allow read: if signedIn() && isMember(roomId);
        allow create: if signedIn() && isMember(roomId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      match /calls/{callId} {
        allow read: if signedIn() && isMember(roomId);
        allow create, update: if signedIn() && isMember(roomId)
          && (request.resource.data.caller == request.auth.uid
            || request.resource.data.callee == request.auth.uid);
        allow delete: if false;

        match /{candidateCollection}/{candidateId} {
          allow read, create: if signedIn() && isMember(roomId)
            && candidateCollection in ['callerCandidates', 'receiverCandidates'];
          allow update, delete: if false;
        }
      }
    }
  }
}